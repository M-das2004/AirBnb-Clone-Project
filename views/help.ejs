<%- layout("/layouts/boilerplate") %>

<div class="container info-page">
    <h1>Help Center</h1>
    <p class="text-muted">
        How can we help you?
    </p>

    <hr>

    <div class="help-item">
        <h4><i class="fa-regular fa-house"></i> How do I create a listing?</h4>
        <p>
            Log in to your account and click on the "Add New Listing"
            option to create your property listing.
        </p>
    </div>

    <div class="help-item">
        <h4><i class="fa-regular fa-pen-to-square"></i> How do I edit a listing?</h4>
        <p>
            Open the listing you want to update and click the Edit button.
        </p>
    </div>

    <div class="help-item">
        <h4><i class="fa-solid fa-trash"></i> How do I delete a listing?</h4>
        <p>
            Open your listing and click the Delete button.
        </p>
    </div>

    <div class="help-item">
        <h4><i class="fa-regular fa-star"></i> How do reviews work?</h4>
        <p>
            Users can share their experience by leaving reviews and ratings
            on listings.
        </p>
    </div>
</div>