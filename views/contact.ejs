<%- layout("/layouts/boilerplate") %>

<div class="container info-page">
    <h1>Contact Us</h1>
    <p class="text-muted">
        We'd love to hear from you!
    </p>

    <hr>

    <div class="contact-info">
        <h4>Email</h4>
        <p>support@wonderlust.com</p>

        <h4>Customer Support</h4>
        <p>Our support team is here to help you with your questions.</p>
    </div>

    <form class="contact-form mt-4">
        <div class="mb-3">
            <label class="form-label">Your Name<sup><span style="color: #fe424d;">*</span></sup></label>
            <input
                type="text"
                class="form-control"
                placeholder="Enter your name"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Your Email<sup><span style="color: #fe424d;">*</span></sup></label>
            <input
                type="email"
                class="form-control"
                placeholder="Enter your email"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Message<sup><span style="color: #fe424d;">*</span></sup></label>
            <textarea
                class="form-control"
                rows="5"
                placeholder="Write your message"
            ></textarea>
        </div>

        <button class="btn btn-danger">
            Send Message
        </button>
    </form>
</div>